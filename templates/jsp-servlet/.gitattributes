# 换行符与文本属性（必须存在，否则 .sh 在 Windows 上会变 CRLF）
#
# 为什么必须：Windows 的 git 默认 core.autocrlf=true，会把 .sh 检出成 CRLF，
# bash 读到 CRLF 会报 $'\r': command not found，
# scripts/ 下 5 个门禁脚本会全部失效，且报错完全不指向换行符。

* text=auto

# ---- 必须永远是 LF ----
*.sh          text eol=lf
*.bash        text eol=lf
Dockerfile*   text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.conf        text eol=lf
*.json        text eol=lf
*.js          text eol=lf
*.mjs         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.vue         text eol=lf
*.css         text eol=lf
*.go          text eol=lf
*.py          text eol=lf
*.java        text eol=lf
*.cs          text eol=lf

# ---- Windows 批处理必须是 CRLF ----
*.cmd         text eol=crlf
*.bat         text eol=crlf

# ---- 二进制 ----
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.jar  binary
*.zip  binary

# ---- 文档 ----
*.md  text
