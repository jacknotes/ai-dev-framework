<?xml version="1.0" encoding="UTF-8"?>
<!--
  后端构建文件（Maven）
  技术栈：Spring Boot 3.3 + Java 21
  用途：AI 多智能体协同开发框架的最小示例后端，仅依赖 Web + Test，不引入数据库。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot 父 POM：统一托管依赖版本与插件版本，子项目无需逐条写版本号 -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>demo</artifactId>
  <version>0.1.0</version>
  <name>java-spring-demo</name>
  <description>Java + Spring Boot 最小示例后端</description>

  <properties>
    <!-- Java 21（LTS）：与 Dockerfile 中的 eclipse-temurin:21 保持一致 -->
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencies>
    <!-- Web 能力：内嵌 Tomcat + Spring MVC + Jackson -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 测试：JUnit 5 + MockMvc + AssertJ + Hamcrest，scope 为 test 不会进入产物 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 打成可执行 fat jar（java -jar 直接运行），并生成 build-info -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
